# Netatmo API credentials (required)
NETATMO_CLIENT_ID=your_client_id_here
NETATMO_CLIENT_SECRET=your_client_secret_here

# Exporter configuration (optional)
NETATMO_EXPORTER_PORT=8000
NETATMO_EXPORTER_REFRESH_INTERVAL=300

# Netatmo API URLs (optional, defaults shown)
# NETATMO_API_URL=https://api.netatmo.com/api/gethomecoachsdata
# NETATMO_AUTH_URL=https://api.netatmo.com/oauth2/authorize
# NETATMO_TOKEN_URL=https://api.netatmo.com/oauth2/token
# NETATMO_REDIRECT_URI=http://localhost:8000/callback
